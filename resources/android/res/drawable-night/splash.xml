<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة البدء (ليلي): لون خلفية التطبيق والأيقونة بحجم ثابت في المنتصف — لا تمطيط على أي شاشة. مُولَّد بـ npm run icons من resources/icon — لا تعدّله يدوياً -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:opacity="opaque">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF151412" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
