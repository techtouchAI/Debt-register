{
  "appId": "com.agrioffice.debtregister",
  "productName": "إدارة المكتب",
  "copyright": "Copyright © 2026 TechTouch AI",
  "asar": true,
  "directories": {
    "output": "release",
    "buildResources": "public"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*",
    "resources/icon/app.ico",
    "package.json",
    "!node_modules/**/*"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "compression": "maximum",
  "removePackageKeywords": true,
  "buildVersion": "1.0.0",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "portable",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "resources/icon/app.ico",
    "executableName": "OfficeManager",
    "artifactName": "OfficeManager-${version}-${os}-${arch}.${ext}",
    "signAndEditExecutable": true,
    "verifyUpdateCodeSignature": false,
    "signtoolOptions": {
      "signingHashAlgorithms": ["sha256"],
      "publisherName": "TechTouch AI"
    },
    "legalTrademarks": "TechTouch AI"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "إدارة المكتب",
    "deleteAppDataOnUninstall": false,
    "include": "electron/installer.nsh",
    "artifactName": "OfficeManager-Setup-${version}-${arch}.${ext}",
    "warningsAsErrors": false,
    "runAfterFinish": true,
    "menuCategory": "TechTouch AI"
  },
  "portable": {
    "artifactName": "OfficeManager-Portable-${version}-${arch}.${ext}",
    "requestExecutionLevel": "user",
    "unicode": true
  }
}
