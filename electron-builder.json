{
  "appId": "com.agrioffice.debtregister",
  "productName": "إدارة المكتب",
  "copyright": "Copyright © 2024 TechTouch AI",
  "asar": true,
  "directories": {
    "output": "release",
    "buildResources": "public"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*",
    "package.json",
    "!node_modules/**/*"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/pwa-512x512.png",
    "artifactName": "OfficeManager-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "إدارة المكتب",
    "deleteAppDataOnUninstall": false,
    "artifactName": "OfficeManager-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "OfficeManager-Portable-${version}.exe"
  }
}
