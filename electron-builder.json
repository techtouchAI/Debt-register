{
  "appId": "com.agrioffice.debtregister",
  "productName": "إدارة المكتب الزراعي",
  "copyright": "Copyright © 2024 Agri Office",
  "directories": {
    "output": "release",
    "buildResources": "public"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/pwa-512x512.png",
    "publisherName": "Agri Office",
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "المكتب الزراعي",
    "installerIcon": "public/pwa-512x512.png",
    "uninstallerIcon": "public/pwa-512x512.png",
    "installerHeaderIcon": "public/pwa-512x512.png"
  },
  "portable": {
    "artifactName": "AgriOffice-Portable-${version}.exe"
  }
}
