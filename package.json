{
  "name": "debt-register-agri-office",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "نظام إدارة المكتب الزراعي - يعمل بدون انترنت - Windows 10/11 و Android",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win --x64",
    "electron:build:win": "npm run build && electron-builder --win --x64 --publish=never",
    "cap:add:android": "npx cap add android && npm run cap:prepare",
    "cap:sync": "npx cap sync && npm run cap:prepare",
    "cap:android": "npm run build && npm run cap:add:android && npx cap sync && npm run cap:prepare && npx cap open android",
    "cap:build:android": "npm run build:android",
    "build:android": "npm run build && (npx cap add android || true) && npm run cap:sync && cd android && ./gradlew assembleDebug",
    "build:windows": "npm run build && electron-builder --win --x64 --publish=never",
    "build:all": "npm run build",
    "workflow:android": "npm install @capacitor/core @capacitor/cli @capacitor/android @capacitor/app @capacitor/filesystem @capacitor/local-notifications @capacitor/share --save && npm run build && npx cap add android || true && npx cap sync android && cd android && ./gradlew assembleDebug",
    "workflow:windows": "npm install electron electron-builder --save-dev && npm run build && npx electron-builder --win --x64 --publish=never",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run audit:shells && npm run lint && npm run typecheck && npm run test && npm run build",
    "cap:prepare": "node scripts/prepare-android.mjs",
    "audit:shells": "node scripts/audit-shells.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0"
  },
  "optionalDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "author": "Agri Office",
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
