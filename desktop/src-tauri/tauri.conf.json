{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agro Office",
  "version": "1.0.0",
  "identifier": "ai.techtouch.agrooffice",
  "build": {
    "beforeDevCommand": "npm run assets",
    "beforeBuildCommand": "npm run assets",
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "title": "المكتب الزراعي — إدارة الفواتير والديون",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Business",
    "shortDescription": "إدارة الفواتير والمخزن والديون دون إنترنت",
    "longDescription": "تطبيق محلي لإدارة المكتب الزراعي والفواتير والمخزون وحسابات الزبائن والديون.",
    "copyright": "Copyright © 2026 TechTouch AI",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
