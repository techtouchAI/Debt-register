{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "صلاحيات التطبيق المحلي: الإشعارات، صندوق حفظ الملفات، كتابة الملف المختار، وإغلاق النافذة بعد تأكيد الخروج",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:path:allow-join",
    "core:path:allow-resolve-directory",
    "notification:default",
    "dialog:allow-save",
    "fs:allow-write-file"
  ]
}
